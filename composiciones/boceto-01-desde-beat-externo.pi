# Boceto 01 — Derivado de análisis de beat externo
#
# Fuente:   sounds/fufu.wav
# Reporte:  tools/out/fufu/report.md
#
# Datos clave del análisis:
#   BPM estimado:  178 (posible half-time feel ~89)
#   Tonalidad:     C (estimación por cromagrama)
#   Duración:      52.35 s
#   Estructura:    intro ~21s sin drums -> drop con batería hasta el final
#
# Este boceto NO reproduce el timbre — reproduce la estructura:
# intro atmosférico + drop rítmico, misma tonalidad y tempo.
# Carácter sonoro elegido libremente (pad + tb303 bass + drums):
# ajustar synths/FX a gusto.

use_bpm 178

# ============================================================
# INTRO — 16 bars (~21.6s), sin batería
# ============================================================

in_thread do
  # Bajo esparcido en C: una nota cada 2 compases
  use_synth :fm
  8.times do
    play :c2, release: 2.0, amp: 0.7, depth: 0.5
    sleep 8
  end
end

in_thread do
  # Pad largo con reverb: acorde cada 4 compases
  use_synth :blade
  with_fx :reverb, room: 0.9, mix: 0.7 do
    4.times do
      play_chord chord(:c3, :minor), release: 14, amp: 0.4, cutoff: 90
      sleep 16
    end
  end
end

sleep 64  # 16 bars de intro (4 beats * 16)

# ============================================================
# DROP — 16 bars (~21.6s), entran drums + bajo activo + melodía
# ============================================================

in_thread do
  # Patrón básico de batería: kick 1-3, snare 2-4, hats 8vos
  16.times do
    4.times do |b|
      sample :drum_bass_hard,     amp: 1.2 if [0, 2].include?(b)
      sample :drum_snare_hard,    amp: 1.0 if [1, 3].include?(b)
      2.times do
        sample :drum_cymbal_closed, amp: 0.4
        sleep 0.5
      end
    end
  end
end

in_thread do
  # Bajo en 8vos (pattern repetido por 16 bars = 128 notas)
  use_synth :tb303
  bass_notes = ring(:c2, :c2, :eb2, :g2, :c2, :bb1, :ab1, :g1)
  128.times do
    play bass_notes.tick, release: 0.4, cutoff: 85, amp: 0.8
    sleep 0.5
  end
end

in_thread do
  # Melodía entra en el bar 3 del drop, frase en C menor pentatónico
  sleep 8
  use_synth :saw
  with_fx :echo, phase: 0.75, decay: 2, mix: 0.4 do
    mel = ring(:c4, :eb4, :g4, :bb4, :g4, :eb4, :d4, :c4)
    112.times do
      play mel.tick, release: 0.3, amp: 0.5, cutoff: 95
      sleep 0.5
    end
  end
end

sleep 64  # 16 bars de drop

# ============================================================
# OUTRO — cierre en C
# ============================================================

play_chord chord(:c3, :minor), release: 5, amp: 0.8
play :c2, release: 5, amp: 0.7
sleep 8
