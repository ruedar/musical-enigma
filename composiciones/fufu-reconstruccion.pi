# fufu — reconstrucción del beat (52 s) con notación x/X/=/-
# ----------------------------------------------------------
# Origen: sounds/fufu.wav (historia de IG). Reconstruido, NO clonado. 88 BPM.
# Notación:  x=normal  X=fuerte(acento)  ==sostiene  -=silencio
# El 808 luce con '=': las notas largas se sostienen sin recargar el patrón.
#
# Nota: la línea de bajo EXACTA transcrita del MIDI (80 notas) sigue disponible
# vía tools/parse_midi.py / historial git. Acá va una versión de rejilla, editable.
# Compará con la celda "solo batería" del notebook y ajustá de oído.

use_bpm 88

# ---------- Decoders de la notación ----------
def toca(patron, sonido, nota: nil, base: 0.8)
  patron.length.times do |i|
    c = patron[i]
    if c == "x" || c == "X"
      amp   = base * (c == "X" ? 1.6 : 1.0)
      largo = 1
      largo += 1 while patron[i + largo] == "="
      if nota
        synth sonido, note: nota, sustain: largo * 0.25, release: 0.1, amp: amp
      else
        sample sonido, sustain: largo * 0.25, release: 0.1, amp: amp
      end
    end
    sleep 0.25
  end
end

# 808 melódico: la rítmica sale del patrón, la altura de la lista de notas.
def toca_bajo(patron, notas, sonido)
  j = 0
  patron.length.times do |i|
    c = patron[i]
    if c == "x" || c == "X"
      amp   = (c == "X") ? 1.4 : 1.0
      largo = 1
      largo += 1 while patron[i + largo] == "="
      synth sonido, note: notas[j % notas.length], sustain: largo * 0.25, release: 0.15, amp: amp
      j += 1
    end
    sleep 0.25
  end
end

# ---------- Patrones (16 pasos = 1 compás) ----------
kick_p  = "X-----X---X-----"
snare_p = "--------X-------"
hat_p   = "x-x-x-x-x-x-x-x-"
bajo_p  = "X=======X===X==="        # 808: notas largas sostenidas con '='
bajo_n  = [:c1, :g1, :as0]           # zona tonal del track (Do menor aprox.)

# ---------- INTRO (2 compases): solo hats, filtrado ----------
with_fx :lpf, cutoff: 85 do
  2.times { toca(hat_p, :drum_cymbal_closed, base: 0.4) }
end

# ---------- BEAT + 808 (8 compases): capas en paralelo ----------
8.times do
  in_thread { toca(kick_p,  :bd_808,             base: 1.3) }
  in_thread { toca(snare_p, :sn_dolf,            base: 0.9) }
  in_thread { toca(hat_p,   :drum_cymbal_closed, base: 0.45) }
  in_thread { toca_bajo(bajo_p, bajo_n, :subpulse) }
  sleep 4
end

# ---------- CIERRE ----------
synth :subpulse, note: :c1, sustain: 1, release: 3, amp: 1.3
sleep 4
# Fin.

# TOCÁ VOS:
# 1) bajo_p: más '=' = notas más largas; más golpes = 808 más movido.
# 2) bajo_n: otras notas graves (:as0, :f1, :ds1).
# 3) Acentuá el kick con X donde quieras el golpe fuerte.
